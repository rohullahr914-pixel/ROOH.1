OPENAI_API_KEY=
# Optional OpenAI model and voice overrides.
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# OPENAI_TEXT_MODEL=gpt-4.1-mini
V0_API_KEY=
# Set true when the browser-to-API route is slower than the API-to-OpenAI route.
NEXT_PUBLIC_COMPRESSED_VOICE=false
YOUTUBE_API_KEY=
SKETCHFAB_API_TOKEN=
# Twelve Data Basic market data key (server side only).
TWELVEDATA_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
# Separate random secrets, each at least 32 characters. Never NEXT_PUBLIC_.
WHATSAPP_OWNER_TOKEN=
WHATSAPP_BRIDGE_SECRET=
WHATSAPP_BRIDGE_PORT=3010
# Optional installed Chromium/Chrome executable path:
WHATSAPP_CHROME_PATH=
WHATSAPP_AUTH_TIMEOUT_MS=180000
WHATSAPP_PREWARM=1
# Text chat (server side only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
